    <!-- JAVASCRIPT GAME LOGIC -->
    <script>
        // Audio Synthesizer using Web Audio API for sound effects without external audio asset links
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;
        let isMuted = false;

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new AudioContext();
            }
            return audioCtx;
        }

        function playSound(type) {
            if (isMuted) return;
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);

                if (type === 'success') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, ctx.currentTime); // C5
                    osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.2); // A5
                    gain.gain.setValueAtTime(0.3, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.3);
                } else if (type === 'error') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, ctx.currentTime); // A3
                    osc.frequency.linearRampToValueAtTime(110, ctx.currentTime + 0.25);
                    gain.gain.setValueAtTime(0.3, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.25);
                } else if (type === 'pop') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(400, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(600, ctx.currentTime + 0.1);
                    gain.gain.setValueAtTime(0.2, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.1);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.1);
                }
            } catch(e) {
                console.log("Audio play error", e);
            }
        }

        function toggleMute() {
            isMuted = !isMuted;
            const icon = document.getElementById('sound-icon');
            if (isMuted) {
                icon.className = 'fa-solid fa-volume-xmark';
            } else {
                icon.className = 'fa-solid fa-volume-high';
            }
        }

        let currentStage = 1;
        let score = 0;

        // Stage 1 Data: 6 Standard Steps
        const stage1Steps = [
            { id: 'step-1', text: '1. Penerimaan Surat (Pemeriksaan fisik & kelengkapan)', order: 1 },
            { id: 'step-2', text: '2. Penyortiran Surat (Memilah dinas, niaga, rahasia)', order: 2 },
            { id: 'step-3', text: '3. Pencatatan ke Buku Agenda Digital', order: 3 },
            { id: 'step-4', text: '4. Pengarahan / Pembuatan Lembar Disposisi', order: 4 },
            { id: 'step-5', text: '5. Pendistribusian Dokumen ke Divisi Tujuan', order: 5 },
            { id: 'step-6', text: '6. Penyimpanan & Pengarsipan Berkas Selesai', order: 6 }
        ];

        // Stage 2 Data: Document Sorting Items
        const stage2Docs = [
            {
                title: 'Surat Undangan Stand Kuliner Pemkot Blitar',
                sender: 'Dinas Perindustrian & Perdagangan Kota Blitar',
                snippet: 'Mengundang PT Kuliner Patria Blitar mengikuti Festival Pecel Blitar & Bazar Kuliner...',
                category: 'Dinas'
            },
            {
                title: 'Tagihan Pembelian Kacang Tanah Suplier Kanigoro',
                sender: 'UD Sumber Tani Kanigoro Blitar',
                snippet: 'Faktur No. FK-882: Tagihan pasokan 200kg Kacang Tanah Grade A untuk Bumbu Pecel...',
                category: 'Keuangan'
            },
            {
                title: 'Pesanan Catering 500 Porsi Nasi Ampok & Es Drop',
                sender: 'Panitia HUT Blitar Regency',
                snippet: 'Mohon disediakan 500 Porsi Nasi Ampok Lauk Uceng Goreng & 500 Es Drop Sriti...',
                category: 'Pemasaran'
            },
            {
                title: 'Laporan Keuangan & Evaluasi Gaji Direksi (Rasia)',
                sender: 'Komisaris Utama PT Kuliner Patria',
                snippet: 'DOKUMEN RAHASIA KEUANGAN DAN BONUS DIREKSI TAHUN 2026 - TAMPAN DIBUKA REKTOR...',
                category: 'Rahasia'
            },
            {
                title: 'Penawaran Kerjasama Suplai Belimbing Karangsari',
                sender: 'Koperasi Belimbing Karangsari Blitar',
                snippet: 'Penawaran pasokan Belimbing Karangsari segar untuk olahan Manisan Belimbing Patria...',
                category: 'Pemasaran'
            }
        ];
        let currentDocIndex = 0;
        let stage2Timer = 45;
        let timerInterval = null;

        // Stage 4 Data: Archive filing items
        const stage4Items = [
            { id: 'f1', code: 'Blitar Pemkot', desc: 'Surat Dinas Pemkot Blitar', bucket: 'A-D' },
            { id: 'f2', code: 'Disperindag', desc: 'Undangan Pameran Disperindag', bucket: 'A-D' },
            { id: 'f3', code: 'Es Drop Sriti', desc: 'Kontrak Lisensi Es Drop Burung Sriti', bucket: 'E-M' },
            { id: 'f4', code: 'Hotel Patria', desc: 'Invoice Catering Hotel Patria Blitar', bucket: 'E-M' },
            { id: 'f5', code: 'Nasi Ampok Karangsari', desc: 'Sertifikat Halal Nasi Ampok', bucket: 'N-Z' },
            { id: 'f6', code: 'Suplier Kacang Kanigoro', desc: 'Nota Pembelian Kacang', bucket: 'N-Z' }
        ];
        let stage4FiledCount = 0;

        function initStage1() {
            const sourceContainer = document.getElementById('stage1-source');
            const targetContainer = document.getElementById('stage1-target');
            
            sourceContainer.innerHTML = '';
            targetContainer.innerHTML = '';

            // Shuffle steps for the source area
            const shuffled = [...stage1Steps].sort(() => Math.random() - 0.5);

            shuffled.forEach(step => {
                const card = document.createElement('div');
                card.id = step.id;
                card.draggable = true;
                card.dataset.order = step.order;
                card.className = 'draggable-card bg-white p-3 rounded-xl border border-slate-200 shadow-sm font-semibold text-xs sm:text-sm text-slate-700 flex items-center justify-between';
                card.innerHTML = `
                    <span>${step.text}</span>
                    <i class="fa-solid fa-grip-vertical text-slate-300"></i>
                `;
                card.ondragstart = (e) => {
                    e.dataTransfer.setData('text/plain', step.id);
                    playSound('pop');
                };
                sourceContainer.appendChild(card);
            });

            // Create 6 empty drop slots
            for (let i = 1; i <= 6; i++) {
                const slot = document.createElement('div');
                slot.className = 'drop-zone p-3 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 min-h-[52px] flex items-center justify-between text-xs font-semibold text-slate-400';
                slot.dataset.slotOrder = i;
                slot.innerHTML = `<span>Langkah ${i} (Letakkan di sini)</span>`;
                
                slot.ondragover = (e) => {
                    e.preventDefault();
                    slot.classList.add('drag-over');
                };
                slot.ondragleave = () => {
                    slot.classList.remove('drag-over');
                };
                slot.ondrop = (e) => {
                    e.preventDefault();
                    slot.classList.remove('drag-over');
                    const cardId = e.dataTransfer.getData('text/plain');
                    const draggedCard = document.getElementById(cardId);
                    if (draggedCard) {
                        slot.innerHTML = '';
                        slot.appendChild(draggedCard);
                        slot.classList.remove('border-dashed', 'bg-slate-50');
                        slot.classList.add('border-solid', 'bg-white', 'border-amber-300');
                        playSound('pop');
                    }
                };
                targetContainer.appendChild(slot);
            }
        }

        function checkStage1() {
            const targetSlots = document.querySelectorAll('#stage1-target > div');
            let correctCount = 0;

            targetSlots.forEach((slot, index) => {
                const childCard = slot.querySelector('.draggable-card');
                if (childCard && parseInt(childCard.dataset.order) === (index + 1)) {
                    correctCount++;
                    slot.classList.remove('border-amber-300', 'border-rose-300');
                    slot.classList.add('border-emerald-500', 'bg-emerald-50/40');
                } else if (childCard) {
                    slot.classList.remove('border-amber-300', 'border-emerald-500');
                    slot.classList.add('border-rose-400', 'bg-rose-50/40');
                }
            });

            const feedback = document.getElementById('stage1-feedback');
            if (correctCount === 6) {
                score += 25;
                updateScore();
                playSound('success');
                feedback.className = "text-sm font-bold text-emerald-600";
                feedback.innerText = "Sempurna! Semua 6 alur penanganan dokumen sudah sesuai standar SMK.";
                setTimeout(() => {
                    switchStage(2);
                }, 1200);
            } else {
                playSound('error');
                feedback.className = "text-sm font-bold text-rose-600";
                feedback.innerText = `Baru ${correctCount} dari 6 urutan yang tepat. Silakan perbaiki urutan yang berwarna merah!`;
            }
        }

        function initStage2() {
            currentDocIndex = 0;
            stage2Timer = 45;
            document.getElementById('sorted-count').innerText = "0 / 5";
            renderCurrentDoc();

            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                stage2Timer--;
                document.getElementById('timer-display').innerText = stage2Timer;
                if (stage2Timer <= 0) {
                    clearInterval(timerInterval);
                    playSound('error');
                    alert('Waktu sortir habis! Mengulang level 2.');
                    initStage2();
                }
            }, 1000);
        }

        function renderCurrentDoc() {
            if (currentDocIndex >= stage2Docs.length) {
                clearInterval(timerInterval);
                playSound('success');
                score += 25;
                updateScore();
                setTimeout(() => {
                    switchStage(3);
                }, 800);
                return;
            }

            const doc = stage2Docs[currentDocIndex];
            document.getElementById('doc-title').innerText = doc.title;
            document.getElementById('doc-sender').innerHTML = `<i class="fa-solid fa-building mr-1"></i> ${doc.sender}`;
            document.getElementById('doc-snippet').innerText = `"${doc.snippet}"`;
        }

        function sortDocument(selectedCategory) {
            const currentDoc = stage2Docs[currentDocIndex];
            if (selectedCategory === currentDoc.category) {
                playSound('success');
                currentDocIndex++;
                document.getElementById('sorted-count').innerText = `${currentDocIndex} / ${stage2Docs.length}`;
                renderCurrentDoc();
            } else {
                playSound('error');
                const card = document.getElementById('stage2-doc-card');
                card.classList.add('animate-bounce');
                setTimeout(() => card.classList.remove('animate-bounce'), 500);
            }
        }

        function submitDisposition(e) {
            e.preventDefault();
            const sender = document.getElementById('input-sender').value;
            const subject = document.getElementById('input-subject').value.trim();
            const division = document.getElementById('input-division').value;
            const instruction = document.getElementById('input-instruction').value;

            if (sender === "Disperindag Kota Blitar" && subject.length > 3 && division === "Dapur Ops" && instruction === "Proses") {
                playSound('success');
                score += 25;
                updateScore();
                alert('Agenda & Lembar Disposisi Berhasil Dicatat Dengan Tepat!');
                switchStage(4);
            } else {
                playSound('error');
                alert('Pengisian Form Disposisi belum sesuai! Periksa kembali pengirim (Disperindag), divisi (Dapur Ops), dan instruksi yang tepat.');
            }
        }

        function initStage4() {
            const deck = document.getElementById('filing-deck');
            deck.innerHTML = '';
            stage4FiledCount = 0;
            document.querySelectorAll('.filed-items').forEach(el => el.innerHTML = '');

            stage4Items.forEach(item => {
                const card = document.createElement('div');
                card.id = item.id;
                card.draggable = true;
                card.dataset.bucket = item.bucket;
                card.className = 'draggable-card bg-amber-50 p-3 rounded-xl border border-amber-300 shadow-sm cursor-grab flex items-center justify-between text-xs font-bold text-slate-800';
                card.innerHTML = `
                    <div>
                        <span class="block text-amber-900">${item.code}</span>
                        <span class="text-[10px] font-normal text-slate-500">${item.desc}</span>
                    </div>
                    <i class="fa-solid fa-folder text-amber-600"></i>
                `;
                card.ondragstart = (e) => {
                    e.dataTransfer.setData('text/plain', item.id);
                    playSound('pop');
                };
                deck.appendChild(card);
            });
        }

        function allowDrop(e) {
            e.preventDefault();
        }

        function handleFilingDrop(e, targetBucket) {
            e.preventDefault();
            const itemId = e.dataTransfer.getData('text/plain');
            const draggedCard = document.getElementById(itemId);

            if (draggedCard) {
                if (draggedCard.dataset.bucket === targetBucket) {
                    playSound('success');
                    const targetCabinet = e.currentTarget.querySelector('.filed-items');
                    draggedCard.classList.remove('bg-amber-50', 'border-amber-300');
                    draggedCard.classList.add('bg-slate-700', 'border-slate-600', 'text-amber-300');
                    targetCabinet.appendChild(draggedCard);
                    stage4FiledCount++;
                    document.getElementById('filing-status').innerText = `Tersimpan ${stage4FiledCount} dari ${stage4Items.length} berkas.`;
                } else {
                    playSound('error');
                    alert(`Gagal menyimpan! Perhatikan kata tangkap abjad nama pengirim untuk Laci ${targetBucket}.`);
                }
            }
        }

        function checkStage4() {
            if (stage4FiledCount === stage4Items.length) {
                playSound('success');
                score += 25;
                updateScore();
                showFinalResults();
            } else {
                playSound('error');
                alert(`Masih ada ${stage4Items.length - stage4FiledCount} berkas yang belum dimasukkan ke dalam laci arsip.`);
            }
        }

        function updateScore() {
            document.getElementById('score-display').innerText = score;
        }

        function switchStage(stageNum) {
            currentStage = stageNum;
            document.getElementById('level-display').innerText = `${currentStage} / 4`;

            // Hide all stages
            document.querySelectorAll('.stage-container').forEach(el => el.classList.add('hidden'));

            // Reset tab styles
            for (let i = 1; i <= 4; i++) {
                const tab = document.getElementById(`step-tab-${i}`);
                if (i === currentStage) {
                    tab.className = 'step-tab p-3 rounded-xl border-2 border-amber-500 bg-amber-50 text-amber-900 font-bold text-center text-xs sm:text-sm transition flex items-center justify-center space-x-2 shadow-sm';
                    tab.classList.remove('opacity-60');
                } else if (i < currentStage) {
                    tab.className = 'step-tab p-3 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-800 font-bold text-center text-xs sm:text-sm transition flex items-center justify-center space-x-2';
                } else {
                    tab.className = 'step-tab p-3 rounded-xl border border-slate-200 bg-white text-slate-400 font-medium text-center text-xs sm:text-sm transition flex items-center justify-center space-x-2 opacity-60';
                }
            }

            // Show target stage
            const targetSection = document.getElementById(`stage-${currentStage}`);
            if (targetSection) targetSection.classList.remove('hidden');

            if (currentStage === 1) initStage1();
            if (currentStage === 2) initStage2();
            if (currentStage === 4) initStage4();
        }

        function resetCurrentLevel() {
            switchStage(currentStage);
        }

        function showFinalResults() {
            document.querySelectorAll('.stage-container').forEach(el => el.classList.add('hidden'));
            document.getElementById('stage-result').classList.remove('hidden');

            document.getElementById('final-score').innerText = score;
            document.getElementById('final-accuracy').innerText = "100%";
            document.getElementById('final-badge').innerText = "Arsiparis Handal (A+)";

            confetti({
                particleCount: 100,
                spread: 70,
                origin: { y: 0.6 }
            });
        }

        function openTheoryModal() {
            document.getElementById('theory-modal').classList.remove('hidden');
        }

        function closeTheoryModal() {
            document.getElementById('theory-modal').classList.add('hidden');
        }

        // Initialize stage 1 on window load
        window.onload = function() {
            initStage1();
        };
    </script>
</body>
</html>
